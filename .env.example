# ─── Audela landing — environment variables ─────────────────────────
# Copy this file to `.env.local` (which is git-ignored) and fill in real values.
# In production, set the same variables in the Vercel dashboard:
#   Project → Settings → Environment Variables

# Contact form endpoint (Formspree).
# Sign up at https://formspree.io, create a form pointing at your inbox,
# and paste the resulting endpoint URL here.
# Example: https://formspree.io/f/xyzabc12
VITE_FORMSPREE_ENDPOINT=
